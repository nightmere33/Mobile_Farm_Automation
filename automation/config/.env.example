# Copy to automation/.env and fill in. Paths are relative to repo root unless absolute.

# Required when more than one device is connected (see `adb devices -l`).
ANDROID_UDID=

# Launcher activity for com.vfs.italyglobal. Discover on a device with VFS installed:
#   adb shell cmd package resolve-activity --brief com.vfs.italyglobal | findstr com.vfs
# Example (replace with your build's activity):
ANDROID_APP_ACTIVITY=com.vfs.italyglobal.SplashActivity

# Appium server (start in another terminal: appium)
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Implicit wait seconds (element lookup)
IMPLICIT_WAIT_SECONDS=15

# Set true to keep app data between runs (faster manual iteration; less reproducible).
ANDROID_NO_RESET=false

# Optional: after country/language tap, type into the first visible EditText (POC only).
# Leave empty to skip. Prefer resource-id-based flows once Inspector locators exist.
POC_SAMPLE_TEXT=
